    {
      "name": "📊 Analytics — Statistics",
      "description": "Aggregation pipeline endpoints that compute macroeconomic statistics across the entire conflict dataset. All endpoints are public.",
      "item": [
        {
          "name": "Overview Summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Overview has required metrics', function () {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data).to.have.property('totalConflicts');",
                  "    pm.expect(data).to.have.property('totalWarCostUsd');",
