                  "pm.test('Metadata contains pagination info', function () {",
                  "    pm.expect(jsonData.metadata).to.have.property('totalCount');",
                  "    pm.expect(jsonData.metadata).to.have.property('totalPages');",
                  "    pm.expect(jsonData.metadata).to.have.property('currentPage');",
                  "});",
