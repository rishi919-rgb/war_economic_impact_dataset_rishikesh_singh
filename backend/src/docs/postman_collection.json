                  "// Auto-save first conflict ID for use in other requests",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set('conflict_id', jsonData.data[0]._id);",
                  "    console.log('✅ conflict_id saved:', jsonData.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/conflicts?page=1&limit=10&sort=-inflationRate",
              "host": ["{{base_url}}"],
              "path": ["conflicts"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Records per page (default: 10, max: 100)"
                },
                {
                  "key": "sort",
                  "value": "-inflationRate",
                  "description": "Sort field. Prefix with - for descending. Allowed: startYear, warCostUsd, inflationRate, gdpChange, reconstructionCostUsd"
                },
                {
                  "key": "region",
                  "value": "Middle East",
                  "description": "Filter by geographical region",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "Ongoing",
                  "description": "Filter by status: Ongoing or Resolved",
                  "disabled": true
                },
                {
                  "key": "type",
                  "value": "Civil War",
                  "description": "Filter by conflict type",
                  "disabled": true
                },
                {
                  "key": "country",
                  "value": "Ukraine",
                  "description": "Filter by primary country",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "iraq",
                  "description": "Regex keyword search across name, country, description",
                  "disabled": true
                }
              ]
            },
            "description": "Retrieve a paginated list of conflict records.\n\n**Access:** Public\n\n**Query Parameters:**\n\n| Parameter | Type | Description |\n|---|---|---|\n| `page` | number | Page number (default: `1`) |\n| `limit` | number | Records per page (default: `10`, max: `100`) |\n| `sort` | string | Sort field. Prefix `-` for descending. Options: `startYear`, `warCostUsd`, `inflationRate`, `gdpChange`, `reconstructionCostUsd` |\n| `region` | string | Filter by geographical region |\n| `status` | string | Filter by `Ongoing` or `Resolved` |\n| `type` | string | Filter by conflict type |\n| `country` | string | Filter by primary country |\n| `search` | string | Regex keyword search across conflict name, country, description |\n\n> ⚡ The test script auto-saves the first record's `_id` to `conflict_id` for use in other requests."
          },
          "response": []
        },
        {
